# ==========================================
# AI Resume Project - Git Ignore
# ==========================================

# -------------------------
# Environment Variables
# -------------------------
.env
.env.*
!.env.example

# Large job dataset
backend/app/dataset/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Python packaging
*.egg-info/
dist/
build/
.eggs/

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.ruff_cache/

# -------------------------
# FastAPI / Uvicorn
# -------------------------
*.log

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build output
frontend/dist/
frontend/.vite/

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/

# -------------------------
# Operating System
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -------------------------
# Temporary Files
# -------------------------
*.tmp
*.temp
*.swp
*.swo

# -------------------------
# Logs
# -------------------------
logs/
*.log

# -------------------------
# Database / Local Data
# -------------------------
*.sqlite
*.sqlite3
*.db

# -------------------------
# Uploaded Files
# -------------------------
# Ignore user-uploaded resumes/documents
uploads/
uploaded_files/

# PDF files generated during development
*.generated.pdf

# -------------------------
# AI / ML Local Files
# -------------------------
# Local model files
models/
*.gguf
*.bin
*.safetensors

# Embedding/cache files
.cache/
.cache_*/

# -------------------------
# Build / Generated Files
# -------------------------
backend/dist/
backend/build/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# Misc
# -------------------------
# Misc
# -------------------------
*.bak
*.old